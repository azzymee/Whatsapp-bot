# Rename this file to .env before running the bot

# Comma-separated list of prefixes the bot will respond to
PREFIXES=!,.,/

# Owner numbers (comma-separated, international format, no + and no spaces)
# Example: 2348012345678,2347098765432
OWNER_NUMBERS= 2348114604706

# Bot display name
BOT_NAME=ZEEM-X ☔

# Log level: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# ---- Added in later phases, safe to leave blank for now ----
GEMINI_API_KEY= your_key_is_here
OPENAI_API_KEY=
WEATHER_API_KEY= your_key_is_here
# ---- Phase 2 ----
# Gemini model used by the .ai / .gemini / .ask command
GEMINI_MODEL=gemini-3.6-flash

# Anti-spam: max messages allowed per window before action is taken
ANTISPAM_MAX_MESSAGES=6
# Anti-spam: sliding window size in milliseconds
ANTISPAM_WINDOW_MS=10000

# Anti-link / anti-spam: number of strikes before an offending member is
# automatically removed (requires the bot to be a group admin)
MAX_STRIKES=3

# ---- Phase 3 ----
# Downloader commands (.ytmp3/.ytmp4/.tiktok/.instagram) refuse to send
# anything larger than this, in megabytes.
MAX_DOWNLOAD_MB=50
STICKER_PACK_NAME=ZEEM-X ☔
STICKER_AUTHOR=ZEEM-X ☔
# Shown as the sticker "pack name" / "author" on stickers made by .sticker
STICKER_PACK_NAME=ZEEM-X ☔
STICKER_AUTHOR=ZEEM-X ☔

# ---- Phase 4 ----
# Economy
CURRENCY_SYMBOL=$
ECONOMY_DAILY_AMOUNT=500
ECONOMY_DAILY_COOLDOWN_HOURS=24
ECONOMY_WORK_MIN=50
ECONOMY_WORK_MAX=300
ECONOMY_WORK_COOLDOWN_MINUTES=30
ECONOMY_ROB_COOLDOWN_HOURS=6
ECONOMY_ROB_SUCCESS_CHANCE=0.4
ECONOMY_ROB_MIN_TARGET_WALLET=100

# Leveling / XP
LEVELING_XP_MIN=10
LEVELING_XP_MAX=25
LEVELING_XP_COOLDOWN_SECONDS=60
LEVELING_ANNOUNCE=true

